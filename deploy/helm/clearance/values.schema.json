{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["image", "replicaCount", "terminationGracePeriodSeconds", "credentialAuthority", "service", "secrets", "env", "productPresentation", "console", "vault", "ingress", "networkPolicy", "podDisruptionBudget", "metrics", "delivery", "backup"],
  "properties": {
    "image": {
      "type": "object",
      "required": ["repository", "digest", "tag", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "tag": { "type": "string", "minLength": 1 },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "replicaCount": { "type": "integer", "minimum": 1 },
    "revisionHistoryLimit": { "type": "integer", "minimum": 0 },
    "terminationGracePeriodSeconds": { "type": "integer", "minimum": 10 },
    "credentialAuthority": {
      "type": "object",
      "required": ["phase", "deploymentId", "drainId", "migrationAttemptId", "expectedRuntimeCount", "migrationLeaseTimeoutMs"],
      "properties": {
        "phase": { "type": "string", "enum": ["bootstrap", "bridge", "drain", "migrate", "serve"] },
        "deploymentId": { "type": "string", "minLength": 1, "maxLength": 200 },
        "drainId": { "type": "string", "maxLength": 200 },
        "migrationAttemptId": { "type": "string", "maxLength": 200 },
        "expectedRuntimeCount": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "migrationLeaseTimeoutMs": { "type": "integer", "minimum": 1000, "maximum": 600000 }
      }
    },
    "restartToken": { "type": "string" },
    "service": {
      "type": "object",
      "required": ["type", "port"],
      "properties": {
        "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "secrets": {
      "type": "object",
      "required": ["existingSecret"],
      "properties": { "existingSecret": { "type": "string", "minLength": 1 } }
    },
    "env": {
      "type": "object",
      "required": ["CLEARANCE_BASE_URL", "CLEARANCE_CORS_ORIGINS", "CLEARANCE_CUSTOM_DOMAIN_TARGET", "CLEARANCE_TRUSTED_PROXY"],
      "properties": {
        "CLEARANCE_BASE_URL": { "type": "string", "minLength": 1, "pattern": "^https://" },
        "CLEARANCE_CORS_ORIGINS": { "type": "string", "minLength": 1 },
        "CLEARANCE_CUSTOM_DOMAIN_TARGET": { "type": "string", "pattern": "^(|[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+)$" },
        "CLEARANCE_TRUSTED_PROXY": { "type": "string", "enum": ["0", "1"] }
      }
    },
    "productPresentation": {
      "type": "object",
      "required": ["managementSchema", "managementPrefix", "customDomains", "emailDomainRecords"],
      "properties": {
        "managementSchema": { "type": "string", "pattern": "^[a-z_][a-z0-9_]{0,62}$" },
        "managementPrefix": { "type": "string", "pattern": "^[a-z_][a-z0-9_]{0,29}$" },
        "customDomains": {
          "type": "object",
          "required": ["enabled", "edge"],
          "properties": {
            "enabled": { "type": "boolean" },
            "edge": {
              "type": "object",
              "required": ["mode", "customerDnsTarget", "tls", "upstream"],
              "properties": {
                "mode": { "type": "string", "enum": ["", "operator-managed"] },
                "customerDnsTarget": { "type": "string", "pattern": "^(|[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)+)$" },
                "tls": {
                  "type": "object",
                  "required": ["certificateLifecycle"],
                  "properties": {
                    "certificateLifecycle": { "type": "string", "enum": ["", "operator-managed-per-domain"] }
                  }
                },
                "upstream": {
                  "type": "object",
                  "required": ["type", "protocol", "hostHeader", "sourcePeers"],
                  "properties": {
                    "type": { "type": "string", "enum": ["", "vault-service"] },
                    "protocol": { "type": "string", "enum": ["", "http"] },
                    "hostHeader": { "type": "string", "enum": ["", "preserve-original-authority"] },
                    "sourcePeers": {
                      "type": "array",
                      "maxItems": 32,
                      "items": { "$ref": "#/definitions/networkPolicyPeer" }
                    }
                  }
                }
              }
            }
          }
        },
        "emailDomainRecords": {
          "type": "object",
          "required": ["existingSecret", "key"],
          "properties": {
            "existingSecret": { "type": "string", "pattern": "^(|[a-z0-9]([-a-z0-9]*[a-z0-9])?)$", "maxLength": 253 },
            "key": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,253}$" }
          }
        }
      }
    },
    "console": {
      "type": "object",
      "required": ["enabled", "image", "replicaCount", "restartToken", "service", "secrets", "resources", "podDisruptionBudget"],
      "properties": {
        "enabled": { "type": "boolean" },
        "image": {
          "type": "object",
          "required": ["repository", "digest", "tag", "pullPolicy"],
          "properties": {
            "repository": { "type": "string" },
            "digest": { "type": "string", "pattern": "^(|sha256:[0-9a-f]{64})$" },
            "tag": { "type": "string" },
            "pullPolicy": { "type": "string", "enum": ["", "Always", "IfNotPresent", "Never"] }
          }
        },
        "replicaCount": { "type": "integer", "minimum": 1 },
        "restartToken": { "type": "string" },
        "service": {
          "type": "object",
          "required": ["type", "port", "sessionAffinity", "sessionAffinityTimeoutSeconds"],
          "properties": {
            "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "sessionAffinity": { "type": "string", "enum": ["ClientIP", "None"] },
            "sessionAffinityTimeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 86400 }
          }
        },
        "apiUrl": { "type": "string" },
        "secrets": {
          "type": "object",
          "required": ["existingSecret"],
          "properties": { "existingSecret": { "type": "string" } }
        },
        "resources": { "type": "object" },
        "podDisruptionBudget": { "$ref": "#/definitions/pdb" }
      }
    },
    "vault": {
      "type": "object",
      "required": ["enabled", "image", "replicaCount", "restartToken", "publicUrl", "projectId", "environmentId", "productName", "homeLabel", "accentColor", "service", "secrets", "resources", "podDisruptionBudget"],
      "properties": {
        "enabled": { "type": "boolean" },
        "image": {
          "type": "object",
          "required": ["repository", "digest", "tag", "pullPolicy"],
          "properties": {
            "repository": { "type": "string" },
            "digest": { "type": "string", "pattern": "^(|sha256:[0-9a-f]{64})$" },
            "tag": { "type": "string" },
            "pullPolicy": { "type": "string", "enum": ["", "Always", "IfNotPresent", "Never"] }
          }
        },
        "replicaCount": { "type": "integer", "minimum": 1 },
        "restartToken": { "type": "string" },
        "publicUrl": { "type": "string", "pattern": "^(|https://[^/?#]+)$" },
        "projectId": { "type": "string", "pattern": "^(|[A-Za-z0-9][A-Za-z0-9._-]{0,127})$" },
        "environmentId": { "type": "string", "pattern": "^(|[A-Za-z0-9][A-Za-z0-9._-]{0,127})$" },
        "productName": { "type": "string", "minLength": 1, "maxLength": 80 },
        "homeLabel": { "type": "string", "minLength": 1, "maxLength": 120 },
        "accentColor": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
        "service": {
          "type": "object",
          "required": ["type", "port"],
          "properties": {
            "type": { "type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        },
        "secrets": {
          "type": "object",
          "required": ["existingSecret"],
          "properties": { "existingSecret": { "type": "string" } }
        },
        "resources": { "type": "object" },
        "podDisruptionBudget": { "$ref": "#/definitions/pdb" }
      }
    },
    "ingress": {
      "type": "object",
      "required": ["api", "console", "vault"],
      "properties": {
        "api": { "$ref": "#/definitions/ingress" },
        "console": { "$ref": "#/definitions/ingress" },
        "vault": { "$ref": "#/definitions/ingress" }
      }
    },
    "networkPolicy": {
      "type": "object",
      "required": ["enabled", "additionalEgress"],
      "properties": { "enabled": { "type": "boolean" }, "additionalEgress": { "type": "array" } }
    },
    "podDisruptionBudget": { "$ref": "#/definitions/pdb" },
    "metrics": {
      "type": "object",
      "required": ["enabled", "path", "networkPolicy", "serviceMonitor"],
      "properties": {
        "enabled": { "type": "boolean" },
        "path": { "type": "string", "pattern": "^/" },
        "networkPolicy": {
          "type": "object",
          "required": ["namespaceSelector", "podSelector"],
          "properties": {
            "namespaceSelector": { "type": "object" },
            "podSelector": { "type": "object" }
          }
        },
        "serviceMonitor": {
          "type": "object",
          "required": ["enabled", "interval", "scrapeTimeout", "additionalLabels"],
          "properties": {
            "enabled": { "type": "boolean" },
            "interval": { "type": "string" },
            "scrapeTimeout": { "type": "string" },
            "additionalLabels": { "type": "object" }
          }
        }
      }
    },
    "delivery": {
      "type": "object",
      "required": ["enabled", "existingSecret", "schema", "prefix", "legacyFingerprintKeyId", "quota", "worker"],
      "properties": {
        "enabled": { "type": "boolean" },
        "existingSecret": { "type": "string" },
        "schema": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,62}$" },
        "prefix": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,39}$" },
        "legacyFingerprintKeyId": { "type": "string", "pattern": "^(|[A-Za-z0-9._-]{1,64})$" },
        "quota": {
          "type": "object",
          "required": ["maxActive", "maxBacklog", "maxEnqueuesPerWindow", "windowMs"],
          "properties": {
            "maxActive": { "type": "integer", "minimum": 1, "maximum": 10000000 },
            "maxBacklog": { "type": "integer", "minimum": 1, "maximum": 10000000 },
            "maxEnqueuesPerWindow": { "type": "integer", "minimum": 1, "maximum": 10000000 },
            "windowMs": { "type": "integer", "minimum": 1000, "maximum": 86400000 }
          }
        },
        "worker": {
          "type": "object",
          "required": ["replicaCount", "restartToken", "healthPort", "terminationGracePeriodSeconds", "concurrency", "pollMs", "leaseMs", "heartbeatMs", "maintenanceMs", "drainTimeoutMs", "maxBodyBytes", "appName", "email", "webhook", "resources", "podDisruptionBudget", "networkPolicy", "metrics"],
          "properties": {
            "replicaCount": { "type": "integer", "minimum": 1 },
            "restartToken": { "type": "string" },
            "healthPort": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "terminationGracePeriodSeconds": { "type": "integer", "minimum": 45 },
            "concurrency": { "type": "integer", "minimum": 1, "maximum": 64 },
            "pollMs": { "type": "integer", "minimum": 25, "maximum": 60000 },
            "leaseMs": { "type": "integer", "minimum": 5000, "maximum": 600000 },
            "heartbeatMs": { "type": "integer", "minimum": 1000, "maximum": 60000 },
            "maintenanceMs": { "type": "integer", "minimum": 1000, "maximum": 300000 },
            "drainTimeoutMs": { "type": "integer", "minimum": 1000, "maximum": 300000 },
            "maxBodyBytes": { "type": "integer", "minimum": 1024, "maximum": 10485760 },
            "appName": { "type": "string", "minLength": 1, "maxLength": 120 },
            "email": {
              "type": "object",
              "required": ["transport", "from", "smtp", "ses"],
              "properties": {
                "transport": { "type": "string", "enum": ["smtp", "ses"] },
                "from": { "type": "string", "maxLength": 320 },
                "smtp": {
                  "type": "object",
                  "required": ["host", "port", "secure", "requireTls", "connectionTimeoutMs", "socketTimeoutMs", "greetingTimeoutMs"],
                  "properties": {
                    "host": { "type": "string" },
                    "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
                    "secure": { "type": "boolean" },
                    "requireTls": { "type": "boolean" },
                    "connectionTimeoutMs": { "type": "integer", "minimum": 1000, "maximum": 120000 },
                    "socketTimeoutMs": { "type": "integer", "minimum": 1000, "maximum": 300000 },
                    "greetingTimeoutMs": { "type": "integer", "minimum": 1000, "maximum": 120000 }
                  }
                },
                "ses": {
                  "type": "object",
                  "required": ["region", "requestTimeoutMs"],
                  "properties": {
                    "region": { "type": "string" },
                    "requestTimeoutMs": { "type": "integer", "minimum": 1000, "maximum": 120000 }
                  }
                }
              }
            },
            "webhook": {
              "type": "object",
              "required": ["dnsTimeoutMs", "connectTimeoutMs", "responseTimeoutMs", "maxResponseBytes"],
              "properties": {
                "dnsTimeoutMs": { "type": "integer", "minimum": 250, "maximum": 60000 },
                "connectTimeoutMs": { "type": "integer", "minimum": 250, "maximum": 60000 },
                "responseTimeoutMs": { "type": "integer", "minimum": 250, "maximum": 120000 },
                "maxResponseBytes": { "type": "integer", "minimum": 0, "maximum": 1048576 }
              }
            },
            "resources": { "$ref": "#/definitions/workerResources" },
            "podDisruptionBudget": { "$ref": "#/definitions/pdb" },
            "networkPolicy": {
              "type": "object",
              "required": ["dnsPeers", "databasePeers", "smtpEgress", "metrics"],
              "properties": {
                "dnsPeers": {
                  "type": "array",
                  "maxItems": 32,
                  "items": { "$ref": "#/definitions/networkPolicyPeer" }
                },
                "databasePeers": {
                  "type": "array",
                  "maxItems": 32,
                  "items": { "$ref": "#/definitions/networkPolicyPeer" }
                },
                "smtpEgress": {
                  "type": "array",
                  "maxItems": 32,
                  "items": { "$ref": "#/definitions/smtpEgressRule" }
                },
                "metrics": {
                  "type": "object",
                  "required": ["namespaceSelector", "podSelector"],
                  "properties": {
                    "namespaceSelector": { "type": "object" },
                    "podSelector": { "type": "object" }
                  }
                }
              }
            },
            "metrics": {
              "type": "object",
              "required": ["enabled", "path", "serviceMonitor"],
              "properties": {
                "enabled": { "type": "boolean" },
                "path": { "type": "string", "const": "/metrics" },
                "serviceMonitor": {
                  "type": "object",
                  "required": ["enabled", "interval", "scrapeTimeout", "additionalLabels"],
                  "properties": {
                    "enabled": { "type": "boolean" },
                    "interval": { "type": "string" },
                    "scrapeTimeout": { "type": "string" },
                    "additionalLabels": { "type": "object" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "backup": {
      "type": "object",
      "required": ["enabled", "image", "schedule", "concurrencyPolicy", "retentionDays", "restoreVerify", "existingSecret", "databaseUrlKey", "copyCommandKey", "existingClaim", "accessModes", "storageSize"],
      "properties": {
        "enabled": { "type": "boolean" },
        "image": {
          "type": "object",
          "required": ["repository", "digest", "tag", "pullPolicy"],
          "properties": {
            "repository": { "type": "string" },
            "digest": { "type": "string", "pattern": "^(|sha256:[0-9a-f]{64})$" },
            "tag": { "type": "string", "minLength": 1 },
            "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] }
          }
        },
        "schedule": { "type": "string", "minLength": 1 },
        "concurrencyPolicy": { "type": "string", "enum": ["Forbid", "Allow", "Replace"] },
        "retentionDays": { "type": "integer", "minimum": 1 },
        "restoreVerify": { "type": "boolean" },
        "existingSecret": { "type": "string" },
        "databaseUrlKey": { "type": "string", "minLength": 1 },
        "copyCommandKey": { "type": "string", "minLength": 1 },
        "existingClaim": { "type": "string" },
        "accessModes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "enum": ["ReadWriteMany"] }
        },
        "storageClassName": { "type": "string" },
        "storageSize": { "type": "string", "minLength": 1 }
      }
    }
  },
  "definitions": {
    "pdb": {
      "type": "object",
      "required": ["enabled", "minAvailable"],
      "properties": { "enabled": { "type": "boolean" }, "minAvailable": { "type": "integer", "minimum": 0 } }
    },
    "ingress": {
      "type": "object",
      "required": ["enabled", "className", "annotations", "host", "path", "pathType", "tls"],
      "properties": {
        "enabled": { "type": "boolean" },
        "className": { "type": "string" },
        "annotations": { "type": "object" },
        "host": { "type": "string" },
        "path": { "type": "string", "pattern": "^/" },
        "pathType": { "type": "string", "enum": ["Prefix", "Exact", "ImplementationSpecific"] },
        "tls": {
          "type": "object",
          "required": ["enabled", "secretName"],
          "properties": { "enabled": { "type": "boolean" }, "secretName": { "type": "string" } }
        }
      }
    },
    "labelSelector": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "matchLabels": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "matchExpressions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["key", "operator"],
            "additionalProperties": false,
            "properties": {
              "key": { "type": "string", "minLength": 1 },
              "operator": { "type": "string", "enum": ["In", "NotIn", "Exists", "DoesNotExist"] },
              "values": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "workerResources": {
      "type": "object",
      "required": ["requests", "limits"],
      "additionalProperties": false,
      "properties": {
        "requests": { "$ref": "#/definitions/cpuMemoryResources" },
        "limits": { "$ref": "#/definitions/cpuMemoryResources" }
      }
    },
    "cpuMemoryResources": {
      "type": "object",
      "required": ["cpu", "memory"],
      "additionalProperties": false,
      "properties": {
        "cpu": { "type": "string", "minLength": 1 },
        "memory": { "type": "string", "minLength": 1 }
      }
    },
    "networkPolicyPeer": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "podSelector": { "$ref": "#/definitions/labelSelector" },
        "namespaceSelector": { "$ref": "#/definitions/labelSelector" },
        "ipBlock": {
          "type": "object",
          "required": ["cidr"],
          "additionalProperties": false,
          "properties": {
            "cidr": {
              "type": "string",
              "pattern": "^[0-9A-Fa-f:.]+/[0-9]{1,3}$",
              "not": { "pattern": "/0+$" }
            },
            "except": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[0-9A-Fa-f:.]+/[0-9]{1,3}$",
                "not": { "pattern": "/0+$" }
              }
            }
          }
        }
      },
      "oneOf": [
        {
          "required": ["ipBlock"],
          "not": { "anyOf": [{ "required": ["podSelector"] }, { "required": ["namespaceSelector"] }] }
        },
        {
          "anyOf": [{ "required": ["podSelector"] }, { "required": ["namespaceSelector"] }],
          "not": { "required": ["ipBlock"] }
        }
      ]
    },
    "smtpEgressRule": {
      "type": "object",
      "required": ["to", "ports"],
      "additionalProperties": false,
      "properties": {
        "to": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/networkPolicyPeer" }
        },
        "ports": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["protocol", "port"],
            "additionalProperties": false,
            "properties": {
              "protocol": { "type": "string", "const": "TCP" },
              "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "console": { "properties": { "enabled": { "const": true } } } } },
      "then": { "properties": { "console": { "properties": { "secrets": { "properties": { "existingSecret": { "minLength": 1 } } } } } } }
    },
    {
      "if": { "properties": { "vault": { "properties": { "enabled": { "const": true } } } } },
      "then": {
        "properties": {
          "vault": {
            "properties": {
              "publicUrl": { "minLength": 1 },
              "projectId": { "minLength": 1 },
              "environmentId": { "minLength": 1 },
              "secrets": { "properties": { "existingSecret": { "minLength": 1 } } }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "productPresentation": { "properties": { "customDomains": { "properties": { "enabled": { "const": true } } } } } } },
      "then": {
        "properties": {
          "env": { "properties": { "CLEARANCE_CUSTOM_DOMAIN_TARGET": { "minLength": 1 } } },
          "networkPolicy": { "properties": { "enabled": { "const": true } } },
          "ingress": {
            "properties": {
              "vault": {
                "properties": {
                  "enabled": { "const": true },
                  "host": { "minLength": 1 },
                  "tls": {
                    "properties": {
                      "enabled": { "const": true },
                      "secretName": { "minLength": 1 }
                    }
                  }
                }
              }
            }
          },
          "productPresentation": {
            "properties": {
              "customDomains": {
                "properties": {
                  "edge": {
                    "properties": {
                      "mode": { "const": "operator-managed" },
                      "customerDnsTarget": { "minLength": 1 },
                      "tls": { "properties": { "certificateLifecycle": { "const": "operator-managed-per-domain" } } },
                      "upstream": {
                        "properties": {
                          "type": { "const": "vault-service" },
                          "protocol": { "const": "http" },
                          "hostHeader": { "const": "preserve-original-authority" },
                          "sourcePeers": { "minItems": 2 }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "vault": {
            "properties": {
              "enabled": { "const": true },
              "service": { "properties": { "type": { "const": "ClusterIP" } } },
              "publicUrl": { "minLength": 1 },
              "projectId": { "minLength": 1 },
              "environmentId": { "minLength": 1 }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "backup": { "properties": { "enabled": { "const": true } } } } },
      "then": {
        "properties": {
          "backup": {
            "properties": {
              "image": { "properties": { "repository": { "minLength": 1 }, "digest": { "pattern": "^sha256:[0-9a-f]{64}$" } } },
              "existingSecret": { "minLength": 1 }
            }
          }
        }
      }
    },
    {
