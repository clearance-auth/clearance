{
  "name": "@clearance/management",
  "version": "0.3.0",
  "description": "Clearance management plane — services, diagnostics, migration, backup on real auth runtime",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/clearance-auth/clearance",
    "directory": "packages/management"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown && node scripts/stage-ops.mjs",
    "test": "vitest run",
    "test:store-v2-events-scale": "CLEARANCE_STORE_V2_SCALE=1 vitest run --disableConsoleIntercept src/__tests__/store-v2-events-scale.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@clearance/auth": "workspace:*",
    "@clearance/core": "workspace:*",
    "@clearance/delivery": "workspace:*",
    "@clearance/key-management": "workspace:*",
    "pg": "^8.14.1"
  },
  "devDependencies": {
    "@clearance/sso": "workspace:*",
    "@clearance/scim": "workspace:*",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.11.11",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
