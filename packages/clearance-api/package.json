{
  "name": "@clearance/api",
  "version": "0.4.0",
  "description": "Clearance management API",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/clearance-auth/clearance",
    "directory": "packages/clearance-api"
  },
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --import @clearance/observability-node/preload --import tsx src/server.ts",
    "start": "node --import @clearance/observability-node/preload dist/server.js",
    "test": "vitest run --maxWorkers=1",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@clearance/management": "workspace:*",
    "@clearance/observability-node": "workspace:*",
    "hono": "^4.13.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsx": "^4.23.12",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
