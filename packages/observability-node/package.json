{
  "name": "@clearance/observability-node",
  "version": "0.3.0",
  "description": "Opt-in Node.js OpenTelemetry bootstrap for Clearance services",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/clearance-auth/clearance",
    "directory": "packages/observability-node"
  },
  "sideEffects": [
    "./src/preload.ts",
    "./src/register.ts"
  ],
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "dev-source": "./src/index.ts",
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./register": {
      "dev-source": "./src/register.ts",
      "types": "./dist/register.d.mts",
      "default": "./dist/register.mjs"
    },
    "./preload": {
      "dev-source": "./src/preload.ts",
      "types": "./dist/preload.d.mts",
      "default": "./dist/preload.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsdown",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.220.0",
    "@opentelemetry/instrumentation-http": "^0.220.0",
    "@opentelemetry/instrumentation-pg": "^0.72.0",
    "@opentelemetry/resources": "^2.9.0",
    "@opentelemetry/sdk-node": "^0.220.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
