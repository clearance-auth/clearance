{
  "name": "@clearance/delivery-worker",
  "version": "0.4.0",
  "description": "Separately deployable SMTP and AWS SES delivery worker for Clearance",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/clearance-auth/clearance",
    "directory": "packages/delivery-worker"
  },
  "bin": {
    "clearance-delivery-worker": "./dist/bin.mjs"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
