{
  "name": "@clearance/delivery-worker",
  "version": "0.3.0",
  "description": "Separately deployable SMTP and AWS SES delivery worker for Clearance",
  "type": "module",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/clearance-auth/clearance", "directory": "packages/delivery-worker" },
  "bin": { "clearance-delivery-worker": "./dist/bin.mjs" },
  "main": "./dist/index.mjs",
