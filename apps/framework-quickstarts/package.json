{
  "name": "@clearance/framework-quickstarts",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "NODE_OPTIONS=--conditions=dev-source tsc -p react/tsconfig.json --noEmit && NODE_OPTIONS=--conditions=dev-source tsc -p express/tsconfig.json --noEmit && NODE_OPTIONS=--conditions=dev-source tsc -p next-app-router/tsconfig.json --noEmit",
    "dev:react": "NODE_OPTIONS=--conditions=dev-source vite --config react/vite.config.ts",
