    "react-dom": "catalog:react19"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.1",
    "@types/react": "catalog:react19",
    "@types/react-dom": "catalog:react19",
    "tsx": "^4.23.12",
    "typescript": "catalog:",
    "vite": "8.2.1"
  }
}
