    "dev:next": "NODE_OPTIONS=--conditions=dev-source next dev next-app-router"
  },
  "dependencies": {
    "@clearance/runtime": "workspace:*",
    "@clearance/verification": "workspace:*",
    "express": "^5.2.1",
    "next": "^16.3.1",
